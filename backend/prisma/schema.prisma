datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model InventoryItem {
  id        String   @id @default(uuid())
  name      String   @db.Text
  categories Category[]
  quantity  Int      @default(0)
  version   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id    String          @id @default(uuid())
  name  String
  slug  String          @unique
  items InventoryItem[]
}

